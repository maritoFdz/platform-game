    "m_SourceType": 1,
    "m_FunctionName": "PaletteSwapp",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float d1 = distance(Color, Original1);\r\nfloat d2 = distance(Color, Original2);\r\nfloat d3 = distance(Color, Original3);\r\nfloat d4 = distance(Color, Original4);\r\nfloat d5 = distance(Color, Original5);\r\nfloat d6 = distance(Color, Original6);\r\nfloat d7 = distance(Color, Original7);\r\n\r\nfloat minDistance = d1;\r\nfloat3 result = New1;\r\n\r\nif (d2 < minDistance)\r\n{\r\n    minDistance = d2;\r\n    result = New2;\r\n}\r\n\r\nif (d3 < minDistance)\r\n{\r\n    minDistance = d3;\r\n    result = New3;\r\n}\r\n\r\nif (d4 < minDistance)\r\n{\r\n    minDistance = d4;\r\n    result = New4;\r\n}\r\n\r\nif (d5 < minDistance)\r\n{\r\n    minDistance = d5;\r\n    result = New5;\r\n}\r\n\r\nif (d6 < minDistance)\r\n{\r\n    minDistance = d6;\r\n    result = New6;\r\n}\r\n\r\nif (d7 < minDistance)\r\n{\r\n    minDistance = d7;\r\n    result = New7;\r\n}\r\n\r\nResult = minDistance <= Tolerance ? result : Color;"
}

